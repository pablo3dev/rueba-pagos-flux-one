Project fluxone_auth {
  database_type: 'PostgreSQL'
  Note: '''
    PostgreSQL 18.6.
    El servicio de autenticación usa un único rol, auth_svc, con acceso exclusivo al esquema auth_schema.
    No existen FK entre esquemas: otros servicios referencian auth_schema.users.id solo lógicamente mediante el claim sub del JWT.
    La tabla pgmigrations es administrada por node-pg-migrate 9 dentro de auth_schema y no se modela.
  '''
}

Table auth_schema.users {
  id uuid [pk]
  email varchar(254) [not null, unique]
  password_hash text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    email se almacena en minúsculas y sin espacios al inicio o al final. password_hash contiene un PHC de Argon2id.
    ALTER TABLE auth_schema.users ADD CONSTRAINT users_email_lower_chk CHECK (email = lower(email));
    Semilla al arrancar con ON CONFLICT DO NOTHING: alice@fluxone.test (11111111-1111-4111-8111-111111111111), bob@fluxone.test (22222222-2222-4222-8222-222222222222), carol@fluxone.test (33333333-3333-4333-8333-333333333333). La contraseña se obtiene de DEMO_USERS_PASSWORD.
  '''
}

Table auth_schema.refresh_tokens {
  id uuid [pk]
  user_id uuid [not null]
  family_id uuid [not null]
  token_hash char(64) [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  replaced_by_id uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    family_id
  }

  Note: '''
    token_hash es el SHA-256 hexadecimal del token opaco. La rotación es de un solo uso; reutilizar un token revocado revoca toda la familia.
  '''
}

Table auth_schema.signing_keys {
  kid uuid [pk]
  alg varchar(10) [not null, default: 'EdDSA']
  public_jwk jsonb [not null]
  private_key_pkcs8 text [not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    ALTER TABLE auth_schema.signing_keys ADD CONSTRAINT signing_keys_alg_chk CHECK (alg = 'EdDSA');
    CREATE UNIQUE INDEX signing_keys_one_active ON auth_schema.signing_keys (active) WHERE active;
    Se genera un par Ed25519 en el primer arranque si no existe una clave activa.
  '''
}

Ref: auth_schema.refresh_tokens.user_id > auth_schema.users.id [delete: cascade]
Ref: auth_schema.refresh_tokens.replaced_by_id > auth_schema.refresh_tokens.id
