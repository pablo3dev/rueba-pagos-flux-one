Project fluxone_payment_payments_external {
  database_type: 'PostgreSQL'
  Note: '''
    PostgreSQL 18.6. Cambio de esquema de este spec sobre payment_schema, aplicado como UNA migración node-pg-migrate 9 nueva con su Down. Solo se altera payment_schema.transfers; accounts no cambia.
    payment_schema.idempotency_keys NO cambia: la operation CREATE_TRANSFER ya existe y cubre las transferencias EXTERNAL; no se añaden operations ni constraints.
    No se crean las tablas reversals ni outbox_events: este spec no implementa reversos ni outbox. Por eso el CHECK de status no admite REVERSED.
    El servicio Pagos sigue usando un único rol (payment_svc) con acceso exclusivo a payment_schema; sin FK entre esquemas. Importes numeric(18,2), única moneda COP.
  '''
}

Table payment_schema.transfers {
  id uuid [pk]
  owner_user_id uuid [not null]
  type varchar(10) [not null]
  from_account_id varchar(20) [not null]
  to_account_id varchar(20) [note: 'ALTERADA: pasa a nullable (NULL en EXTERNAL)']
  to_external_account varchar(34) [note: 'NUEVA: cuenta destino en el banco externo; solo EXTERNAL']
  amount numeric(18,2) [not null]
  currency char(3) [not null, default: 'COP']
  status varchar(16) [not null]
  failure_reason varchar(40)
  rail_reference varchar(64) [unique, note: 'NUEVA: id::text de la transferencia; solo EXTERNAL']
  rail_attempts integer [not null, default: 0, note: 'NUEVA']
  next_attempt_at timestamptz [note: 'NUEVA: próximo intento de despacho o conciliación']
  lease_until timestamptz [note: 'NUEVA: arrendamiento del worker sobre la fila']
  last_rail_outcome varchar(16) [note: 'NUEVA: último resultado observado del riel']
  correlation_id varchar(64)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (from_account_id, `created_at DESC`, `id DESC`)
    (to_account_id, `created_at DESC`, `id DESC`)
    next_attempt_at [name: 'transfers_rail_work_idx', note: 'parcial: WHERE type = ''EXTERNAL'' AND status IN (''PENDING'',''UNKNOWN'')']
  }

  Note: '''
    Migración Up (en este orden):
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_type_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_status_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_failure_reason_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_distinct_chk;
    ALTER TABLE payment_schema.transfers ALTER COLUMN to_account_id DROP NOT NULL;
    ALTER TABLE payment_schema.transfers ADD COLUMN to_external_account varchar(34);
    ALTER TABLE payment_schema.transfers ADD COLUMN rail_reference varchar(64) CONSTRAINT transfers_rail_reference_key UNIQUE;
    ALTER TABLE payment_schema.transfers ADD COLUMN rail_attempts integer NOT NULL DEFAULT 0;
    ALTER TABLE payment_schema.transfers ADD COLUMN next_attempt_at timestamptz;
    ALTER TABLE payment_schema.transfers ADD COLUMN lease_until timestamptz;
    ALTER TABLE payment_schema.transfers ADD COLUMN last_rail_outcome varchar(16);
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_type_chk CHECK (type IN ('INTERNAL','EXTERNAL'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_status_chk CHECK (status IN ('PENDING','COMPLETED','FAILED','UNKNOWN'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_failure_reason_chk CHECK (failure_reason IS NULL OR failure_reason IN ('INSUFFICIENT_FUNDS','RAIL_REJECTED','RAIL_UNAVAILABLE'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_external_account_chk CHECK (to_external_account IS NULL OR to_external_account ~ '^[A-Z0-9-]{6,34}$');
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_last_rail_outcome_chk CHECK (last_rail_outcome IS NULL OR last_rail_outcome IN ('ACCEPTED','REJECTED','UNAVAILABLE','TIMEOUT','NETWORK_ERROR','NOT_FOUND'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_shape_chk CHECK ((type = 'INTERNAL' AND to_account_id IS NOT NULL AND to_external_account IS NULL) OR (type = 'EXTERNAL' AND to_account_id IS NULL AND to_external_account IS NOT NULL));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_distinct_chk CHECK (to_account_id IS NULL OR from_account_id <> to_account_id);
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_internal_status_chk CHECK (type = 'EXTERNAL' OR status IN ('COMPLETED','FAILED'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_rail_ref_chk CHECK ((type = 'EXTERNAL') = (rail_reference IS NOT NULL));
    CREATE INDEX transfers_rail_work_idx ON payment_schema.transfers (next_attempt_at) WHERE type = 'EXTERNAL' AND status IN ('PENDING','UNKNOWN');
    Sin cambios: transfers_amount_chk, transfers_currency_chk, transfers_failure_chk ((status = 'FAILED') = (failure_reason IS NOT NULL)), los dos índices keyset y las FK a accounts (una FK admite NULL en to_account_id). Las filas INTERNAL ya existentes cumplen los nuevos CHECK (to_external_account y rail_reference NULL).
    Migración Down (en este orden; falla si existen filas EXTERNAL, por diseño: no se borran transferencias ni se pierde dinero):
    DROP INDEX payment_schema.transfers_rail_work_idx;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_rail_ref_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_internal_status_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_distinct_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_shape_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_last_rail_outcome_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_external_account_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_failure_reason_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_status_chk;
    ALTER TABLE payment_schema.transfers DROP CONSTRAINT transfers_type_chk;
    ALTER TABLE payment_schema.transfers DROP COLUMN last_rail_outcome, DROP COLUMN lease_until, DROP COLUMN next_attempt_at, DROP COLUMN rail_attempts, DROP COLUMN rail_reference, DROP COLUMN to_external_account;
    ALTER TABLE payment_schema.transfers ALTER COLUMN to_account_id SET NOT NULL;
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_type_chk CHECK (type = 'INTERNAL');
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_status_chk CHECK (status IN ('COMPLETED','FAILED'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_failure_reason_chk CHECK (failure_reason IS NULL OR failure_reason = 'INSUFFICIENT_FUNDS');
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_distinct_chk CHECK (from_account_id <> to_account_id);
    owner_user_id es el iniciador y dueño de la cuenta origen. rail_reference equivale a id::text en transferencias EXTERNAL y es la referencia con la que el riel deduplica; se reutiliza idéntica en cada reenvío.
    Pertenencia y visibilidad (RN-11): una transferencia es visible solo para el dueño de la cuenta origen o, si es INTERNAL, también para el dueño de la cuenta destino. Predicado para el usuario U: EXISTS (SELECT 1 FROM payment_schema.accounts a WHERE a.owner_user_id = U AND (a.id = t.from_account_id OR (t.type = 'INTERNAL' AND a.id = t.to_account_id))). Las EXTERNAL se filtran solo por origen (to_account_id es NULL). Para cualquier otro usuario la transferencia no existe (404). El historial sigue paginado por cursor keyset (created_at DESC, id DESC).
    Máquina de estados EXTERNAL: nace PENDING con la cuenta origen ya debitada (fondos retenidos) y rail_attempts = 0; o nace FAILED(INSUFFICIENT_FUNDS) sin débito ni intentos. PENDING pasa a COMPLETED por aceptación (200 del riel); a FAILED(RAIL_REJECTED) con reembolso en la misma transacción por rechazo (422); a FAILED(RAIL_UNAVAILABLE) con reembolso al agotar 5 intentos con 503/fallo de conexión (entre intentos permanece PENDING con next_attempt_at = now() + min(2^rail_attempts, 30) segundos); a UNKNOWN por timeout de 10 s o error de red tras el envío, con fondos retenidos. UNKNOWN pasa a COMPLETED si el riel confirma aceptada; a FAILED(RAIL_REJECTED) con reembolso si confirma rechazada; si responde no encontrada se reenvía con la MISMA rail_reference aplicando la regla de PENDING; si no está disponible o hay timeout permanece UNKNOWN con next_attempt_at por el mismo backoff, sin límite de intentos. FAILED y COMPLETED son terminales en este spec (no existe REVERSED). INTERNAL nace COMPLETED o FAILED(INSUFFICIENT_FUNDS) en una sola transacción; nunca PENDING ni UNKNOWN (transfers_internal_status_chk).
    El despachador y el conciliador seleccionan con transfers_rail_work_idx: type = 'EXTERNAL' AND status IN ('PENDING','UNKNOWN') AND next_attempt_at <= now() AND (lease_until IS NULL OR lease_until < now()) FOR UPDATE SKIP LOCKED; al tomar la fila fijan lease_until. last_rail_outcome registra el último resultado del riel; completed_at se fija al pasar a COMPLETED o FAILED.
  '''
}

Ref: payment_schema.transfers.from_account_id > payment_schema.accounts.id
Ref: payment_schema.transfers.to_account_id > payment_schema.accounts.id
