Project fluxone_payment {
  database_type: 'PostgreSQL'
  Note: '''
    PostgreSQL 18.6.
    Cada servicio usa un único rol con acceso exclusivo a su esquema: auth_svc a auth_schema, payment_svc a payment_schema y audit_svc a audit_schema.
    No existen FK entre esquemas. payment_schema.owner_user_id, payment_schema.user_id, payment_schema.requested_by_user_id y audit_schema.actor_user_id referencian auth_schema.users.id solo lógicamente mediante el claim sub del JWT.
    Las tablas pgmigrations son administradas por node-pg-migrate 9 en cada esquema y no se modelan.
    El riel bancario simulado no usa PostgreSQL; conserva su ledger JSONL en un volumen.
    Todos los importes usan numeric(18,2) y la única moneda admitida es COP.
  '''
}

Table auth_schema.users {
  id uuid [pk]
  email varchar(254) [not null, unique]
  password_hash text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    email se almacena en minúsculas y sin espacios al inicio o al final. password_hash contiene un PHC de Argon2id.
    ALTER TABLE auth_schema.users ADD CONSTRAINT users_email_lower_chk CHECK (email = lower(email));
    Semilla al arrancar con ON CONFLICT (id) DO NOTHING: alice@fluxone.test (11111111-1111-4111-8111-111111111111), bob@fluxone.test (22222222-2222-4222-8222-222222222222), carol@fluxone.test (33333333-3333-4333-8333-333333333333). La contraseña se obtiene de DEMO_USERS_PASSWORD.
  '''
}

Table auth_schema.refresh_tokens {
  id uuid [pk]
  user_id uuid [not null]
  family_id uuid [not null]
  token_hash char(64) [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  replaced_by_id uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    family_id
  }

  Note: '''
    token_hash es el SHA-256 hexadecimal del token opaco. La rotación es de un solo uso; reutilizar un token revocado revoca toda la familia.
  '''
}

Table auth_schema.signing_keys {
  kid uuid [pk]
  alg varchar(10) [not null, default: 'EdDSA']
  public_jwk jsonb [not null]
  private_key_pkcs8 text [not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    ALTER TABLE auth_schema.signing_keys ADD CONSTRAINT signing_keys_alg_chk CHECK (alg = 'EdDSA');
    CREATE UNIQUE INDEX signing_keys_one_active ON auth_schema.signing_keys (active) WHERE active;
    Se genera un par Ed25519 en el primer arranque si no existe una clave activa.
  '''
}

Table payment_schema.accounts {
  id varchar(20) [pk]
  owner_user_id uuid [not null]
  currency char(3) [not null, default: 'COP']
  balance numeric(18,2) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    owner_user_id
  }

  Note: '''
    ALTER TABLE payment_schema.accounts ADD CONSTRAINT accounts_id_chk CHECK (id ~ '^ACC-[0-9]{3,}$');
    ALTER TABLE payment_schema.accounts ADD CONSTRAINT accounts_currency_chk CHECK (currency = 'COP');
    ALTER TABLE payment_schema.accounts ADD CONSTRAINT accounts_balance_chk CHECK (balance >= 0);
    Semilla en migración: ACC-001 pertenece a 11111111-1111-4111-8111-111111111111 y tiene 1000000.00 COP; ACC-002 pertenece a 22222222-2222-4222-8222-222222222222 y tiene 500000.00 COP; ACC-003 pertenece a 33333333-3333-4333-8333-333333333333 y tiene 0.00 COP.
  '''
}

Table payment_schema.transfers {
  id uuid [pk]
  owner_user_id uuid [not null]
  type varchar(10) [not null]
  from_account_id varchar(20) [not null]
  to_account_id varchar(20)
  to_external_account varchar(34)
  amount numeric(18,2) [not null]
  currency char(3) [not null, default: 'COP']
  status varchar(16) [not null]
  failure_reason varchar(40)
  rail_reference varchar(64) [unique]
  rail_attempts integer [not null, default: 0]
  next_attempt_at timestamptz
  lease_until timestamptz
  last_rail_outcome varchar(16)
  correlation_id varchar(64)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (from_account_id, `created_at DESC`, `id DESC`)
    (to_account_id, `created_at DESC`, `id DESC`)
  }

  Note: '''
    owner_user_id es el iniciador y dueño de la cuenta origen. rail_reference equivale a id::text para transferencias EXTERNAL.
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_type_chk CHECK (type IN ('INTERNAL','EXTERNAL'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_external_account_chk CHECK (to_external_account IS NULL OR to_external_account ~ '^[A-Z0-9-]{6,34}$');
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_amount_chk CHECK (amount > 0);
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_currency_chk CHECK (currency = 'COP');
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_status_chk CHECK (status IN ('PENDING','COMPLETED','FAILED','UNKNOWN','REVERSED'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_failure_reason_chk CHECK (failure_reason IS NULL OR failure_reason IN ('INSUFFICIENT_FUNDS','RAIL_REJECTED','RAIL_UNAVAILABLE'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_last_rail_outcome_chk CHECK (last_rail_outcome IS NULL OR last_rail_outcome IN ('ACCEPTED','REJECTED','UNAVAILABLE','TIMEOUT','NETWORK_ERROR','NOT_FOUND'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_shape_chk CHECK ((type='INTERNAL' AND to_account_id IS NOT NULL AND to_external_account IS NULL) OR (type='EXTERNAL' AND to_account_id IS NULL AND to_external_account IS NOT NULL));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_distinct_chk CHECK (to_account_id IS NULL OR from_account_id <> to_account_id);
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_internal_status_chk CHECK (type='EXTERNAL' OR status IN ('COMPLETED','FAILED','REVERSED'));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_failure_chk CHECK ((status='FAILED') = (failure_reason IS NOT NULL));
    ALTER TABLE payment_schema.transfers ADD CONSTRAINT transfers_rail_ref_chk CHECK ((type='EXTERNAL') = (rail_reference IS NOT NULL));
    CREATE INDEX transfers_rail_work_idx ON payment_schema.transfers (next_attempt_at) WHERE type='EXTERNAL' AND status IN ('PENDING','UNKNOWN');
    Máquina de estados: INTERNAL nace COMPLETED o FAILED(INSUFFICIENT_FUNDS) en una sola transacción y COMPLETED puede pasar a REVERSED. EXTERNAL nace PENDING con el origen ya debitado y los fondos retenidos; pasa a COMPLETED por 200, a FAILED con reembolso por 422/RAIL_REJECTED o por 503 tras agotar 5 intentos/RAIL_UNAVAILABLE, o nace FAILED(INSUFFICIENT_FUNDS) sin débito. Timeout de 10 s o error de red tras el envío lleva a UNKNOWN; la conciliación lleva UNKNOWN a COMPLETED o a FAILED(RAIL_REJECTED) con reembolso. COMPLETED puede pasar a REVERSED.
  '''
}

Table payment_schema.reversals {
  id uuid [pk]
  transfer_id uuid [not null]
  requested_by_user_id uuid [not null]
  amount numeric(18,2) [not null]
  status varchar(16) [not null]
  rejection_reason varchar(40)
  rail_reference varchar(64) [unique]
  rail_attempts integer [not null, default: 0]
  next_attempt_at timestamptz
  lease_until timestamptz
  last_rail_outcome varchar(16)
  correlation_id varchar(64)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  Note: '''
    amount equivale al importe de la transferencia: solo existe reverso total. rail_reference equivale a id::text cuando la transferencia es EXTERNAL.
    ALTER TABLE payment_schema.reversals ADD CONSTRAINT reversals_amount_chk CHECK (amount > 0);
    ALTER TABLE payment_schema.reversals ADD CONSTRAINT reversals_status_chk CHECK (status IN ('PENDING','COMPLETED','REJECTED','UNKNOWN'));
    ALTER TABLE payment_schema.reversals ADD CONSTRAINT reversals_rejection_reason_chk CHECK (rejection_reason IS NULL OR rejection_reason IN ('RAIL_REJECTED','RAIL_UNAVAILABLE'));
    ALTER TABLE payment_schema.reversals ADD CONSTRAINT reversals_last_rail_outcome_chk CHECK (last_rail_outcome IS NULL OR last_rail_outcome IN ('ACCEPTED','REJECTED','UNAVAILABLE','TIMEOUT','NETWORK_ERROR','NOT_FOUND'));
    ALTER TABLE payment_schema.reversals ADD CONSTRAINT reversals_rejection_chk CHECK ((status='REJECTED') = (rejection_reason IS NOT NULL));
    CREATE UNIQUE INDEX reversals_one_active_per_transfer ON payment_schema.reversals (transfer_id) WHERE status IN ('PENDING','UNKNOWN','COMPLETED');
    CREATE INDEX reversals_rail_work_idx ON payment_schema.reversals (next_attempt_at) WHERE status IN ('PENDING','UNKNOWN');
    Una transferencia se reversa una sola vez; un reverso REJECTED permite un nuevo intento. El reverso INTERNAL nace COMPLETED en la misma transacción que mueve los saldos; si la cuenta destino no tiene saldo suficiente, no se crea el registro.
  '''
}

Table payment_schema.idempotency_keys {
  user_id uuid [not null]
  operation varchar(80) [not null]
  idempotency_key varchar(255) [not null]
  request_hash char(64) [not null]
  status varchar(16) [not null]
  response_status smallint
  response_body jsonb
  resource_id uuid
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (user_id, operation, idempotency_key) [pk]
  }

  Note: '''
    operation admite CREATE_TRANSFER o CREATE_REVERSAL:<transferId>. request_hash es el SHA-256 hexadecimal del JSON canónico del body con claves ordenadas concatenado con operation.
    ALTER TABLE payment_schema.idempotency_keys ADD CONSTRAINT idempotency_keys_status_chk CHECK (status IN ('IN_PROGRESS','COMPLETED'));
    Se inserta con INSERT ... ON CONFLICT DO NOTHING dentro de la MISMA transacción de negocio. IN_PROGRESS nunca queda visible después del commit. No existe TTL ni purga porque están fuera de alcance.
  '''
}

Table payment_schema.outbox_events {
  id uuid [pk]
  event_type varchar(60) [not null]
  aggregate_type varchar(20) [not null, default: 'TRANSFER']
  aggregate_id uuid [not null]
  payload jsonb [not null]
  correlation_id varchar(64)
  attempts integer [not null, default: 0]
  next_attempt_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  last_error text
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    id equivale a eventId y event_type es la routing key. El evento se inserta en la misma transacción que el cambio de estado.
    CREATE INDEX outbox_pending_idx ON payment_schema.outbox_events (next_attempt_at, created_at) WHERE published_at IS NULL;
    El relay usa SELECT ... WHERE published_at IS NULL AND next_attempt_at <= now() ORDER BY created_at, id FOR UPDATE SKIP LOCKED LIMIT 50.
  '''
}

Table audit_schema.audit_entries {
  event_id uuid [pk]
  event_type varchar(60) [not null]
  aggregate_type varchar(20) [not null]
  aggregate_id uuid [not null]
  actor_user_id uuid
  visible_to_user_ids uuid[] [not null]
  correlation_id varchar(64)
  occurred_at timestamptz [not null]
  received_at timestamptz [not null, default: `now()`]
  payload jsonb [not null]

  indexes {
    (aggregate_id, occurred_at, event_id)
  }

  Note: '''
    actor_user_id es null para cambios hechos por workers.
    ALTER TABLE audit_schema.audit_entries ADD CONSTRAINT audit_entries_event_type_chk CHECK (event_type IN ('transfer.created','transfer.completed','transfer.failed','transfer.unknown','transfer.reversal_requested','transfer.reversed','transfer.reversal_rejected'));
    ALTER TABLE audit_schema.audit_entries ADD CONSTRAINT audit_entries_aggregate_type_chk CHECK (aggregate_type = 'TRANSFER');
    ALTER TABLE audit_schema.audit_entries ADD CONSTRAINT audit_entries_visible_users_chk CHECK (cardinality(visible_to_user_ids) >= 1);
    CREATE INDEX audit_entries_visible_gin ON audit_schema.audit_entries USING gin (visible_to_user_ids);
    La inserción usa ON CONFLICT (event_id) DO NOTHING para deduplicar entregas at-least-once. La tabla es append-only: audit_svc recibe únicamente SELECT e INSERT sobre ella, sin UPDATE ni DELETE.
  '''
}

Ref: auth_schema.refresh_tokens.user_id > auth_schema.users.id [delete: cascade]
Ref: auth_schema.refresh_tokens.replaced_by_id > auth_schema.refresh_tokens.id
Ref: payment_schema.transfers.from_account_id > payment_schema.accounts.id
Ref: payment_schema.transfers.to_account_id > payment_schema.accounts.id
Ref: payment_schema.reversals.transfer_id > payment_schema.transfers.id
